DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"

# Production only (do not use these values locally). For Vercel + Supabase,
# DATABASE_URL should use Supavisor transaction pooling; DIRECT_URL is for migrations.
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."
# OBJECT_STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="public-key-used-only-by-the-RLS-verification-script"
# SUPABASE_SERVICE_ROLE_KEY="server-only-secret"
# SUPABASE_STORAGE_BUCKET="mary-royal-private"
# OBJECT_STORAGE_DRIVER="supabase" # or "local" with persistent disk storage
# DIRECTOR_BOOTSTRAP_TOKEN="temporary-one-time-secret-minimum-32-characters"
# DIRECTOR_NAME="Mary Royal Director"
# DIRECTOR_EMAIL="director@example.org"
# DIRECTOR_PASSWORD="temporary-strong-password"
# DIRECT_URL="postgresql://..." # direct migration/backup connection; never commit a real URL
# BACKUP_ENCRYPTION_KEY="base64url-encoded-32-byte-key"
# BACKUP_DIR="backups"
# PRIVATE_UPLOADS_DIR="private-uploads"
# UPLOADS_DIR="private-uploads"
