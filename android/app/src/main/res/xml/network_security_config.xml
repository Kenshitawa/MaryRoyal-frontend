<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prohibit cleartext HTTP globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Mary Royal domain configuration with strict HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">maryroyal.onrender.com</domain>
        <domain includeSubdomains="true">maryroyalschool.co.ke</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
