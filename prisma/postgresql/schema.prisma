generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  DIRECTOR
  HEAD_TEACHER
  DEPUTY
  SECRETARY
  ACCOUNTANT
  TEACHER
  WELFARE_CHAIR
  NON_TEACHING_STAFF
  PARENT
  LEARNER
}
model School {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  motto           String               @default("Hard work pays")
  slogan          String?              @default("Nurturing Excellence Through CBE")
  logoUrl         String               @default("/mary-royal-logo.png")
  primaryColour   String               @default("#1d4ed8")
  secondaryColour String               @default("#102653")
  accentColour    String               @default("#d97706")
  contactEmail    String?
  contactPhone    String?
  poBox           String?
  physicalAddress String?
  status          String               @default("ACTIVE")
  provisioningKey String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  paymentConfig   SchoolPaymentConfig?
  users           User[]
  learners        Learner[]
}

model SchoolPaymentConfig {
  id                            String   @id @default(cuid())
  schoolId                      String   @unique
  school                        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  paybillNumber                 String?
  accountFormat                 String   @default("ADMISSION_NO")
  tillNumber                    String?
  bankName                      String?
  bankBranch                    String?
  bankAccountNumber             String?
  bankAccountName               String?
  darajaConsumerKeyEncrypted    String?
  darajaConsumerSecretEncrypted String?
  darajaPasskeyEncrypted        String?
  darajaShortcode               String?
  darajaEnvironment             String   @default("sandbox")
  updatedAt                     DateTime @updatedAt
}

model SuperAdmin {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  failedLogins     Int      @default(0)
  suspended        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                  String             @id @default(cuid())
  schoolId            String             @default("school_demo_mary_royal")
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  avatarUrl           String?
  staffNumber         String?
  tscNumber           String?
  qualifications      String?
  employmentTitle     String?
  email               String
  username            String?
  phone               String?
  governmentId        String?
  passwordHash        String
  role                Role
  forcePasswordChange Boolean            @default(true)
  twoFactorSecretEncrypted String?
  twoFactorEnabled    Boolean            @default(false)
  sessionVersion      Int                @default(0)
  suspended           Boolean            @default(false)
  suspensionReason    String?
  failedLogins        Int                @default(0)
  createdAt           DateTime           @default(now())
  auditEvents         AuditEvent[]
  assignments         TeacherAssignment[]
  assessmentsEntered  Assessment[]       @relation("AssessmentAuthor")
  assessmentHistory   AssessmentHistory[] @relation("AssessmentEditor")
  invoicesCreated    FeeInvoice[]        @relation("InvoiceCreator")
  paymentsRecorded   FeePayment[]        @relation("PaymentRecorder")
  paymentHistory     FeePaymentHistory[] @relation("PaymentEditor")
  expensesRecorded   FeeExpense[]        @relation("ExpenseRecorder")
  payrollAsStaff     PayrollEntry[]      @relation("PayrollStaff")
  payrollEntered     PayrollEntry[]      @relation("PayrollRecorder")
  payrollHistory     PayrollHistory[]    @relation("PayrollEditor")
  learnerLinks       GuardianLink[]
  classTeacherAssignments ClassTeacherAssignment[]
  teachingLogs       TeachingLog[]
  assignmentsCreated Assignment[]
  learningResources LearningResource[]
  complaintsOpened  Complaint[] @relation("ComplaintOpener")
  complaintsAssigned Complaint[] @relation("ComplaintAssignee")
  complaintRepliesAuthored ComplaintReply[]
  admissionDrafts AdmissionDraft[] @relation("AdmissionCreator")
  admissionDocuments AdmissionDocument[] @relation("AdmissionUploader")
  learningVideosAdded LearningVideo[] @relation("LearningVideoAuthor")
  learningVideoWatches LearningVideoWatch[]
  feeStructuresCreated FeeStructure[] @relation("FeeStructureCreator")
  staffAttendanceRecords StaffAttendance[] @relation("StaffAttendanceUser")
  staffAttendanceEntered StaffAttendance[] @relation("StaffAttendanceRecorder")
  disciplineIncidentsRecorded DisciplineIncident[] @relation("DisciplineRecorder")
  uiTheme             String?            @default("system")
  examSessionsCreated ExamSession[]      @relation("ExamSessionCreator")
  rubricsCreated      CbcRubric[]        @relation("RubricCreator")
  waiversRequested    FeeWaiver[]        @relation("WaiverRequester")
  waiversApproved     FeeWaiver[]        @relation("WaiverApprover")
  isWelfareChair      Boolean            @default(false)
  textbooksCreated    Textbook[]         @relation("TextbookCreator")
  textbooksIssued     TextbookIssue[]    @relation("TextbookIssuer")
  textbooksReceived   TextbookIssue[]    @relation("TextbookRecipient")
  schemesOfWork       SchemeOfWork[]     @relation("SchemeAuthor")
  timetablesCreated   SchoolTimetable[]  @relation("TimetableCreator")
  timetablesVerified  SchoolTimetable[]  @relation("TimetableVerifier")
  welfareMember       WelfareMember?
  welfareContributionsRecorded WelfareContribution[] @relation("WelfareRecorder")
  welfareProductsCreated WelfareProduct[] @relation("WelfareProductCreator")
  notifications       Notification[]
  staffProfile        StaffProfile?
  staffDocumentsUploaded StaffDocument[] @relation("StaffDocUploader")
  staffHistoryAuthored StaffHistory[]   @relation("StaffHistoryActor")
  staffDraftsCreated  StaffDraft[]     @relation("StaffDraftCreator")
  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([schoolId])
}
model Learner {
  id          String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo         String
  name        String
  grade       String
  gender      String
  archivedAt  DateTime?
  admissionStatus String @default("APPROVED")
  admissionApprovedById String?
  admissionApprovedAt DateTime?
  attendance  Attendance[]
  assessments Assessment[]
  invoices    FeeInvoice[]
  credits     FeeCredit[]
  guardians   GuardianLink[]
  assignmentSubmissions AssignmentSubmission[]
  learningGameAttempts LearningGameAttempt[]
  profile LearnerProfile?
  admissionDraft AdmissionDraft?
  learningVideoWatches LearningVideoWatch[]
  disciplineIncidents DisciplineIncident[]
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
}
model LearnerProfile {
  id                    String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId             String   @unique
  learner               Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  nationality           String   @default("Kenyan")
  upiNumber             String?
  stream                String?
  admissionDate         DateTime?
  previousSchool        String?
  previousClass         String?
  reasonForLeaving      String?
  religion              String?
  languagesSpoken       String   @default("")
  county                String   @default("")
  subCounty             String   @default("")
  ward                  String   @default("")
  village               String   @default("")
  physicalAddress       String   @default("")
  landmark              String?
  distanceToSchoolKm    Float?
  transportMeans        String?
  latitude              Float?
  longitude             Float?
  knownConditions       String?
  allergies             String?
  currentMedication     String?
  specialNeeds          String?
  bloodGroup            String?
  doctorOrHospital      String?
  immunizationStatus    String?
  healthInsurance       String?
  feePayer               String?
  consentAt              DateTime?
  guardians              LearnerGuardian[]
  emergencyContacts      LearnerEmergencyContact[]
  pickupPersons          LearnerPickupPerson[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  @@index([county, subCounty])
  @@index([schoolId])
}
model LearnerGuardian {
  id             String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fullName       String
  relationship  String
  idNumber       String?
  phone          String
  alternatePhone String?
  whatsapp       Boolean  @default(false)
  email          String?
  occupation     String?
  employer       String?
  homeAddress    String?
  workAddress    String?
  paysFees       Boolean  @default(false)
  primaryContact Boolean  @default(false)
  createdAt      DateTime @default(now())
  @@index([profileId, primaryContact])
  @@index([phone])
  @@index([schoolId])
}
model LearnerEmergencyContact {
  id             String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fullName       String
  relationship  String
  phone          String
  createdAt      DateTime @default(now())
  @@index([profileId])
  @@index([schoolId])
}
model LearnerPickupPerson {
  id             String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  profileId      String
  profile        LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fullName       String
  relationship  String
  phone          String
  createdAt      DateTime @default(now())
  @@index([profileId])
  @@index([schoolId])
}
model AdmissionDraft {
  id           String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  admissionNo  String
  createdById  String
  createdBy    User     @relation("AdmissionCreator", fields: [createdById], references: [id])
  learnerId    String?  @unique
  learner      Learner? @relation(fields: [learnerId], references: [id])
  payload      String   @default("{}")
  currentStep  Int      @default(1)
  status       String   @default("DRAFT")
  submittedAt  DateTime?
  enrolledAt   DateTime?
  documents    AdmissionDocument[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([createdById, status, updatedAt])
  @@index([status, updatedAt])
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
}
model AdmissionDocument {
  id          String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  draftId     String
  draft       AdmissionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  category    String
  originalName String
  storageKey  String   @unique
  contentType String
  sizeBytes   Int
  uploadedById String
  uploadedBy  User     @relation("AdmissionUploader", fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
  @@index([draftId, category])
  @@index([schoolId])
}
model AdmissionCounter {
  id         String @id
  schoolId            String       @default("school_demo_mary_royal")
  lastNumber Int    @default(0)
  @@index([schoolId])
}
model SchoolSetting {
  id        String   @id @default(cuid())
  schoolId  String   @default("school_demo_mary_royal")
  key       String
  value     String
  updatedAt DateTime @updatedAt
  @@unique([schoolId, key])
  @@index([schoolId])
}
model CbcLevel {
  id         String  @id @default(cuid())
  schoolId   String  @default("school_demo_mary_royal")
  code       String
  label      String
  minScore   Float
  maxScore   Float
  descriptor String
  sortOrder  Int
  active     Boolean @default(true)
  @@unique([schoolId, code])
  @@unique([schoolId, sortOrder])
  @@index([schoolId])
}
model GuardianLink {
  id        String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  relation  String   @default("Guardian")
  createdAt DateTime @default(now())
  @@unique([userId, learnerId])
  @@index([learnerId])
  @@index([schoolId])
}
model Attendance {
  id        String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id])
  date      DateTime
  status    String
  @@unique([learnerId, date])
  @@index([date])
  @@index([schoolId])
}
model TeacherAssignment {
  id        String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade     String
  subject   String
  @@unique([teacherId, grade, subject])
  @@index([teacherId, grade])
  @@index([schoolId])
}
model ClassTeacherAssignment {
  id        String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade     String
  @@index([teacherId])
  @@unique([schoolId, grade])
  @@index([schoolId])
}
model TeachingLog {
  id            String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  teacherId     String
  teacher       User     @relation(fields: [teacherId], references: [id])
  grade         String
  subject       String
  topics        String
  reflection    String?
  status        String   @default("SUBMITTED")
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([teacherId, createdAt])
  @@index([status, createdAt])
  @@index([schoolId])
}
model Assignment {
  id           String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  title        String
  instructions String
  grade        String
  subject      String
  dueAt        DateTime?
  maxScore     Int      @default(100)
  answerKey    String?
  autoMark     Boolean  @default(false)
  attachmentUrl String?
  attachmentType String?
  teacherId    String
  teacher      User     @relation(fields: [teacherId], references: [id])
  createdAt    DateTime @default(now())
  submissions  AssignmentSubmission[]
  @@index([grade, subject, dueAt])
  @@index([teacherId, createdAt])
  @@index([schoolId])
}
model AssignmentSubmission {
  id           String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learnerId    String
  learner      Learner    @relation(fields: [learnerId], references: [id])
  response     String
  attachmentUrl String?
  attachmentType String?
  score        Int?
  feedback     String?
  status       String     @default("SUBMITTED")
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@unique([assignmentId, learnerId])
  @@index([learnerId, submittedAt])
  @@index([assignmentId, status])
  @@index([schoolId])
}
model LearningResource {
  id          String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  title       String
  description String
  grade       String
  subject     String
  kind        String
  url         String
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  @@index([grade, subject, createdAt])
  @@index([teacherId, createdAt])
  @@index([schoolId])
}
model LearningGameAttempt {
  id        String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  gameKey   String
  score     Int
  maxScore  Int
  createdAt DateTime @default(now())
  @@index([learnerId, createdAt])
  @@index([learnerId, gameKey])
  @@index([schoolId])
}
model Complaint {
  id          String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  subject     String
  category    String   @default("OTHER")
  message     String
  audience    String
  reporterName String?
  reporterRole String?
  status      String   @default("OPEN")
  openedById  String
  openedBy    User     @relation("ComplaintOpener", fields: [openedById], references: [id])
  assignedToId String?
  assignedTo  User?    @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  learnerId   String?
  attachmentKey String?
  attachmentName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  replies     ComplaintReply[]
  @@index([openedById, createdAt])
  @@index([assignedToId, status])
  @@index([schoolId])
}
model ComplaintReply {
  id          String    @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  message     String
  createdAt   DateTime  @default(now())
  @@index([complaintId, createdAt])
  @@index([schoolId])
}
model Assessment {
  id          String             @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId   String
  learner     Learner            @relation(fields: [learnerId], references: [id])
  enteredById String?
  enteredBy   User?              @relation("AssessmentAuthor", fields: [enteredById], references: [id])
  subject     String
  score       Float
  term        String
  strand      String?
  competency  String?
  comment     String?
  reviewComment String?
  status      String             @default("DRAFT")
  version     Int                @default(1)
  examSessionId String?
  examSession ExamSession?       @relation(fields: [examSessionId], references: [id])
  rubricCode  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  history     AssessmentHistory[]
  @@index([learnerId, term])
  @@index([enteredById, term])
  @@index([status, term])
  @@unique([learnerId, subject, term])
  @@index([schoolId])
}
model AssessmentHistory {
  id           String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User       @relation("AssessmentEditor", fields: [actorId], references: [id])
  version      Int
  oldScore     Float?
  newScore     Float
  createdAt    DateTime   @default(now())
  @@index([assessmentId, version])
  @@unique([assessmentId, version])
  @@index([schoolId])
}
model FeeInvoice {
  id           String        @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId    String
  learner      Learner       @relation(fields: [learnerId], references: [id])
  term         String
  dueAt        DateTime?
  status       String        @default("OPEN")
  creditApplied Int          @default(0)
  createdById  String
  createdBy    User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  structureId  String?
  structure    FeeStructure? @relation(fields: [structureId], references: [id])
  structureVersion Int?
  createdAt    DateTime      @default(now())
  lines        InvoiceLine[]
  payments     FeePayment[]
  waivers      FeeWaiver[]
  @@unique([learnerId, term])
  @@index([term, status])
  @@index([schoolId])
}
model InvoiceLine {
  id          String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Int
  @@index([invoiceId])
  @@index([schoolId])
}

model FeeStructure {
  id            String              @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  grade         String
  term          String
  version       Int
  effectiveFrom DateTime
  active        Boolean             @default(true)
  createdById   String
  createdBy     User                @relation("FeeStructureCreator", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  lines         FeeStructureLine[]
  invoices      FeeInvoice[]

  @@unique([schoolId, grade, term, version])
  @@index([grade, term, active])
  @@index([schoolId])
}

model FeeStructureLine {
  id          String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Int
  optional    Boolean      @default(false)

  @@index([structureId])
  @@index([schoolId])
}
model ReceiptCounter {
  id         String @id
  schoolId            String       @default("school_demo_mary_royal")
  lastNumber Int    @default(0)
  @@index([schoolId])
}
model FeePayment {
  id             String              @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  invoiceId      String
  invoice        FeeInvoice          @relation(fields: [invoiceId], references: [id])
  receiptNo      String
  amount         Int
  method         String
  mpesaCode      String?
  reference      String?
  status         String              @default("RECORDED")
  confirmedById  String?
  confirmedAt    DateTime?
  voidReason     String?
  version        Int                 @default(1)
  recordedById   String
  recordedBy     User                @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  history        FeePaymentHistory[]
  credit         FeeCredit?
  @@index([invoiceId, status])
  @@index([createdAt])
  @@unique([schoolId, receiptNo])
  @@index([schoolId])
}
model FeeCredit {
  id              String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId       String
  learner         Learner    @relation(fields: [learnerId], references: [id])
  sourcePaymentId String     @unique
  sourcePayment   FeePayment @relation(fields: [sourcePaymentId], references: [id])
  amount          Int
  remaining       Int
  status          String     @default("AVAILABLE")
  createdAt       DateTime   @default(now())
  @@index([learnerId, status])
  @@index([schoolId])
}
model FeePaymentHistory {
  id          String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  paymentId   String
  payment     FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User       @relation("PaymentEditor", fields: [actorId], references: [id])
  version     Int
  amount      Int
  method      String
  status      String
  reason      String?
  createdAt   DateTime   @default(now())
  @@unique([paymentId, version])
  @@index([paymentId, createdAt])
  @@index([schoolId])
}
model FeeExpense {
  id           String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  category     String
  supplier     String?
  amount       Int
  description  String
  paidAt       DateTime @default(now())
  enteredById  String
  enteredBy    User     @relation("ExpenseRecorder", fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())
  @@index([paidAt, category])
  @@index([schoolId])
}
model PayrollEntry {
  id          String           @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffId     String
  staff       User             @relation("PayrollStaff", fields: [staffId], references: [id])
  period      String
  grossAmount Int
  deductions  Int              @default(0)
  netAmount   Int
  status      String           @default("PENDING")
  version     Int              @default(1)
  reference   String?
  paidAt      DateTime?
  enteredById String
  enteredBy   User             @relation("PayrollRecorder", fields: [enteredById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  history     PayrollHistory[]
  @@unique([staffId, period])
  @@index([period, status])
  @@index([schoolId])
}
model PayrollHistory {
  id          String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  payrollId   String
  payroll     PayrollEntry @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User         @relation("PayrollEditor", fields: [actorId], references: [id])
  version     Int
  grossAmount Int
  deductions  Int
  netAmount   Int
  status      String
  reason      String?
  createdAt   DateTime     @default(now())
  @@unique([payrollId, version])
  @@index([payrollId, createdAt])
  @@index([schoolId])
}
model AuditEvent {
  id        String   @id @default(cuid())
  schoolId            String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([schoolId])
}


model LearningVideo {
  id        String                @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  title     String
  videoId   String
  grade     String
  subject   String
  strand    String
  subStrand String?
  source    String                @default("KICD_EDUTV")
  status    String                @default("VERIFIED")
  addedById String
  addedBy   User                  @relation("LearningVideoAuthor", fields: [addedById], references: [id])
  createdAt DateTime              @default(now())
  watches   LearningVideoWatch[]

  @@index([grade, subject, strand, status])
  @@unique([schoolId, videoId])
  @@index([schoolId])
}

model LearningVideoWatch {
  id        String        @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  videoId   String
  video     LearningVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  watchedAt DateTime      @default(now())

  @@unique([videoId, learnerId, userId])
  @@index([learnerId, watchedAt])
  @@index([userId, watchedAt])
  @@index([schoolId])
}

model StaffAttendance {
  id          String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffId     String
  staff       User     @relation("StaffAttendanceUser", fields: [staffId], references: [id])
  date        DateTime
  status      String
  checkInAt   DateTime?
  note        String?
  recordedById String
  recordedBy  User     @relation("StaffAttendanceRecorder", fields: [recordedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([staffId, date])
  @@index([date, status])
  @@index([recordedById, date])
  @@index([schoolId])
}

model DisciplineIncident {
  id            String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  learnerId     String
  learner       Learner  @relation(fields: [learnerId], references: [id])
  incidentAt    DateTime
  category      String
  severity      String
  summary       String
  actionTaken   String
  parentNotifiedAt DateTime?
  followUpAt    DateTime?
  status        String   @default("OPEN")
  recordedById  String
  recordedBy    User     @relation("DisciplineRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([learnerId, incidentAt])
  @@index([status, followUpAt])
  @@index([schoolId])
}

model ExamSession {
  id                 String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  name               String       // e.g. "2026 Term 1 End-Term"
  term               String       // e.g. "2026 Term 1"
  status             String       @default("DRAFT") // DRAFT, ACTIVE, CLOSED, PUBLISHED
  startDate          DateTime?
  endDate            DateTime?
  marksOpenAt        DateTime?
  marksCloseAt       DateTime?
  classesJson        String       @default("[]")
  subjectsJson       String       @default("[]")
  timetableJson      String       @default("[]")
  reopenReason       String?
  reopenApprovedById String?
  createdById        String
  createdBy          User         @relation("ExamSessionCreator", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  assessments        Assessment[]

  @@index([term, status])
  @@index([createdById])
  @@index([schoolId])
}

model CbcRubric {
  id            String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  version       Int      @default(1)
  code          String   // EE, ME, AE, BE, etc.
  label         String   // Exceeding Expectations
  minScore      Float
  maxScore      Float
  descriptor    String
  color         String   // Hex or color identifier
  learningArea  String?
  gradeBand     String?
  effectiveDate DateTime @default(now())
  active        Boolean  @default(true)
  createdById   String
  createdBy     User     @relation("RubricCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code, version])
  @@index([gradeBand, learningArea])
  @@index([schoolId])
}

model FeeWaiver {
  id            String     @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  invoiceId     String
  invoice       FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Int
  reason        String
  status        String     @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  requestedBy   User       @relation("WaiverRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?      @relation("WaiverApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  decisionNote  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([invoiceId, status])
  @@index([requestedById])
  @@index([schoolId])
}

model Textbook {
  id              String          @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  title           String
  subject         String
  grade           String
  publisher       String?
  curriculumCode  String?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  createdById     String
  createdBy       User            @relation("TextbookCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  issues          TextbookIssue[]

  @@index([grade, subject])
  @@index([schoolId])
}

model TextbookIssue {
  id              String    @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  textbookId      String
  textbook        Textbook  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         User      @relation("TextbookRecipient", fields: [teacherId], references: [id])
  copyNumber      String?
  issuedById      String
  issuedBy        User      @relation("TextbookIssuer", fields: [issuedById], references: [id])
  issuedAt        DateTime  @default(now())
  dueDate         DateTime?
  status          String    @default("ISSUED_PENDING_CONFIRMATION") // ISSUED_PENDING_CONFIRMATION, CONFIRMED, RETURN_REQUESTED, RETURNED
  confirmedAt     DateTime?
  returnedAt      DateTime?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([teacherId, status])
  @@index([textbookId, status])
  @@index([schoolId])
}

model SchemeOfWork {
  id                  String    @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  teacherId           String
  teacher             User      @relation("SchemeAuthor", fields: [teacherId], references: [id])
  grade               String
  subject             String
  term                String
  year                Int       @default(2026)
  week                Int       @default(1)
  lessonNo            Int       @default(1)
  strand              String
  subStrand           String
  learningOutcomes    String
  keyInquiryQuestions String?
  learningExperiences String
  learningResources   String
  assessmentMethods   String
  reflection          String?
