  @@index([schoolId])
}

model WelfareMember {
  id                  String                @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSavings        Int                   @default(0)
  joinedAt            DateTime              @default(now())
  active              Boolean               @default(true)
  contributions       WelfareContribution[]
  loans               WelfareLoan[]

  @@index([active])
  @@index([schoolId])
}

model WelfareContribution {
  id              String         @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  memberId        String
  member          WelfareMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  amount          Int
  category        String         @default("MONTHLY_SAVINGS")
  productTitle    String?
  receiptRef      String?
  notes           String?
  recordedById    String
  recordedBy      User           @relation("WelfareRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime       @default(now())

  @@index([memberId, year, month])
  @@index([category])
  @@index([schoolId])
}

model WelfareProduct {
  id              String    @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  title           String
  description     String
  targetAmount    Int       @default(0)
  monthlyAmount   Int?
  status          String    @default("ACTIVE")
  createdById     String
  createdBy       User      @relation("WelfareProductCreator", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([schoolId])
}

model WelfareLoan {
  id                    String         @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  memberId              String
  member                WelfareMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type                  String
  principalAmount       Int
  repaymentTermMonths   Int            @default(1)
  monthlyDeduction      Int            @default(0)
  status                String         @default("PENDING_HEADTEACHER")
  repaidAmount          Int            @default(0)
  purpose               String?
  headteacherNotes      String?
  headteacherApprovedAt DateTime?
  directorNotes         String?
  disbursedAt           DateTime?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([memberId, status])
  @@index([status])
  @@index([schoolId])
}

model Notification {
  id              String    @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String    @default("INFO")
  link            String?
  read            Boolean   @default(false)
  readAt          DateTime?
  actionRequired  Boolean   @default(false)
  actionDone      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, read, readAt])
  @@index([userId, actionRequired])
  @@index([schoolId])
}

model StaffProfile {
  id                         String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                     String?
  dateOfBirth                DateTime?
  nationalId                 String?
  nationality                String   @default("Kenyan")
  maritalStatus              String?
  alternatePhone             String?
  residenceAddress           String?
  county                     String?
  dateJoined                 DateTime?
  employmentType             String?  // permanent, contract, BOM, part-time
  department                 String?
  lineManager                String?
  probationEndDate           DateTime?
  educationHistory           String?  // structured JSON or notes
  professionalQualifications String?
  certificates               String?
  specializations            String?
  yearsOfExperience          Float?
  previousEmployers          String?
  // Restricted statutory and payroll details (DIRECTOR, HEAD_TEACHER, ACCOUNTANT only)
  kraPin                     String?
  nssfNumber                 String?
  shaNumber                  String?  // Social Health Authority (formerly NHIF)
  bankName                   String?
  bankAccountName            String?
  bankAccountNumber          String?
  bankBranch                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  emergencyContacts          StaffEmergencyContact[]
  referees                   StaffReferee[]
  documents                  StaffDocument[]
  editHistory                StaffHistory[]
  @@index([userId])
  @@index([schoolId])
}

model StaffEmergencyContact {
  id             String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  fullName       String
  relationship   String
  phone          String
  isNextOfKin    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  @@index([staffProfileId])
  @@index([schoolId])
}

model StaffReferee {
  id             String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  fullName       String
  organization   String
  title          String?
  phone          String
  email          String?
  createdAt      DateTime     @default(now())
  @@index([staffProfileId])
  @@index([schoolId])
}

model StaffDocument {
  id             String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  category       String       // ID_COPY, TSC_CARD, ACADEMIC_CERTIFICATE, CV, CONTRACT, PASSPORT_PHOTO
  originalName   String
  storageKey     String       @unique
  contentType    String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     User         @relation("StaffDocUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())
  @@index([staffProfileId, category])
  @@index([schoolId])
}

model StaffHistory {
  id             String       @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation("StaffHistoryActor", fields: [actorId], references: [id])
  field          String
  oldValue       String?
  newValue       String?
  createdAt      DateTime     @default(now())
  @@index([staffProfileId, createdAt])
  @@index([schoolId])
}

model StaffDraft {
  id          String   @id @default(cuid())
  schoolId            String       @default("school_demo_mary_royal")
  createdById String
  createdBy   User     @relation("StaffDraftCreator", fields: [createdById], references: [id])
  payload     String   @default("{}")
  currentStep Int      @default(1)
